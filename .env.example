# Copy to .env.local and fill in. See README.md for where each value comes from.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
CRON_SECRET=

# White-label: display name shown on the login page, sidebar header, and
# browser tab title. Defaults to "Bugarswim" if unset — set this per client
# when reusing this codebase as a template for a new club (see README.md).
NEXT_PUBLIC_CLUB_NAME=
